<idea-plugin>
    <resource-bundle>zigbrains.LangBundle</resource-bundle>
    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="Zig File"
                implementationClass="com.falsepattern.zigbrains.zig.ZigFileType"
                fieldName="INSTANCE"
                language="Zig"
                extensions="zig"/>
        <fileType
                name="Zon File"
                implementationClass="com.falsepattern.zigbrains.zon.ZonFileType"
                fieldName="INSTANCE"
                language="Zon"
                extensions="zon"/>
    </extensions>
</idea-plugin>