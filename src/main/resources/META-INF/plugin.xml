<idea-plugin>
    <id>com.falsepattern.zigbrains</id>
    <name>ZigBrains</name>
    <vendor>FalsePattern</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>
    <content>
        <module name="com.falsepattern.zigbrains.lang" loading="required"/>
        <module name="com.falsepattern.zigbrains.core" loading="required"/>
        <module name="com.falsepattern.zigbrains.lsp" loading="optional"/>
        <module name="com.falsepattern.zigbrains.cidr" loading="optional"/>
        <module name="com.falsepattern.zigbrains.clion" loading="optional"/>
    </content>
</idea-plugin>